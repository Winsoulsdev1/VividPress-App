# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — Settings > API Keys & Webhooks (use TEST keys until you're ready to go live)
PAYSTACK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# Resend — resend.com, for order status emails (free tier is enough to start)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=VividPress <orders@yourdomain.com>

# Admin panel password (you choose this — keep it private)
ADMIN_PASSWORD=change-this-password

# Public site URL (used in emails for links back to the site)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Your WhatsApp number for the "questions? chat with us" links, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=2349130627542
